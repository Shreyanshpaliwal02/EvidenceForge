# Optional configuration. The default app needs no API key or model download.
# From backend/: uv run --env-file ../.env uvicorn evidenceforge.api:app --host 127.0.0.1 --port 8033
EVIDENCEFORGE_RETRIEVAL_MODE=bm25
EVIDENCEFORGE_GENERATION_MODE=extractive

# Keep all state and any opt-in models local.
# EVIDENCEFORGE_DATA_DIR=/absolute/path/to/evidenceforge-data
# Neural cache must already contain dense/ and rerank/ ONNX/tokenizer assets.
# Startup and requests do not download missing models automatically.
# EVIDENCEFORGE_MODEL_CACHE=/absolute/path/to/model-cache
# EVIDENCEFORGE_ENABLE_NEURAL=1
# EVIDENCEFORGE_DENSE_MODEL=BAAI/bge-small-en-v1.5
# EVIDENCEFORGE_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Optional local OpenAI-compatible server, configured separately.
# Enabling generation requires a real model name available on that server.
# EVIDENCEFORGE_GENERATION_MODE=llm
# EVIDENCEFORGE_LLM_BASE_URL=http://127.0.0.1:11434/v1
# EVIDENCEFORGE_LLM_MODEL=replace-with-your-installed-model
# EVIDENCEFORGE_LLM_API_KEY=

# Multi-agent layer (LangGraph supervisor + LangChain create_agent specialists) runs
# against a LOCAL Ollama server you start yourself: `ollama serve` then
# `ollama pull qwen3.5:9b`. The app never downloads models or starts Ollama;
# when the server or model is missing, /api/agents/* fails closed with 503.
# EVIDENCEFORGE_OLLAMA_BASE_URL=http://127.0.0.1:11434
# EVIDENCEFORGE_AGENT_MODEL=qwen3.5:9b
# EVIDENCEFORGE_AGENT_REASONING=0
# EVIDENCEFORGE_AGENT_TOOLS=inprocess        # or mcp (spawns python -m evidenceforge.mcp_server over stdio)
# EVIDENCEFORGE_AGENT_MAX_HANDOFFS=8
# EVIDENCEFORGE_AGENT_MAX_STEPS=4
# EVIDENCEFORGE_AGENT_MAX_TOKENS=700
# EVIDENCEFORGE_AGENT_TIMEOUT_S=240
# EVIDENCEFORGE_LIVE_AGENT_TESTS=0           # 1 runs the live qwen3.5:9b smoke test in pytest

# Remote generation is disabled unless explicitly opted in; requires HTTPS.
# This sends retrieved content and questions to the configured provider.
# Do not enable for confidential material without appropriate authorization.
# EVIDENCEFORGE_ALLOW_REMOTE_LLM=1
